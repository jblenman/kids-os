<?xml version="1.0"?>
<!-- kids-os kid session: labwc with the windows always maximized and Chrome drawing its own frame (the ChromeOS look). -->
<labwc_config>
  <core>
    <decoration>client</decoration>
    <gap>0</gap>
  </core>
  <placement><policy>center</policy></placement>
  <theme>
    <name></name>
    <cornerRadius>0</cornerRadius>
  </theme>
  <focus><followMouse>no</followMouse></focus>
  <keyboard>
    <!-- no <default/>: nothing for a kid to stumble into; Ctrl+Alt+F2 (admin console) is handled by the compositor itself -->
    <keybind key="A-Tab"><action name="NextWindow"/></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"/></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"/></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"/></keybind>
  </keyboard>
  <mouse>
    <!-- no <default/> either: no root menu on right-click -->
  </mouse>
  <windowRules>
    <windowRule identifier="*" serverDecoration="no">
      <action name="Maximize"/>
    </windowRule>
  </windowRules>
</labwc_config>
