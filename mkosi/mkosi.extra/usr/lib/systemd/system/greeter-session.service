[Unit]
Description=Sign-in screen (PIN) on tty1
After=systemd-user-sessions.service systemd-logind.service kids-sessiond.service
Wants=kids-sessiond.service
Conflicts=getty@tty1.service kid-session.service
After=getty@tty1.service
# only when a PIN is configured and the session is not already unlocked
ConditionPathExists=/etc/kids-os/pin.hash
ConditionPathExists=!/run/kids-os/unlocked
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
EnvironmentFile=-/etc/kids-os/kids-os.env
User=greeter
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=WLR_RENDERER_ALLOW_SOFTWARE=1
Environment=XDG_CURRENT_DESKTOP=labwc:wlroots
ExecStart=/usr/bin/labwc -C /etc/kids-os/labwc-greeter
ExecStopPost=-/usr/bin/loginctl terminate-user greeter
Restart=always
RestartSec=3

# started by kids-os-session.service (boot) or kids-sessiond (unlock / sign-out), never enabled directly
