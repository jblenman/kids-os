#!/usr/bin/python3
"""kids-sessiond — the small root helper behind the kids-os shell pages.

Serves the shell pages (login, launcher) and a tiny API on 127.0.0.1:7707:
  GET  /api/config            the shell configuration (/etc/kids-os/config.json) + whether a PIN is set
  POST /api/unlock  {pin}     check the PIN; on success mark the session unlocked and start kid-session
  POST /api/launch  {url}     open a URL in the kid's main Chrome and close the launcher window
  POST /api/signout           end the kid session; the sign-in screen comes back (when a PIN is set)
  POST /api/power   {action}  poweroff | reboot
Loopback only; the PIN is the only secret and lives salted+hashed in /etc/kids-os/pin.hash (set with kids-os-set-pin).
"""
import hashlib, hmac, json, os, pathlib, secrets, subprocess, threading, time, traceback
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

SHELL = pathlib.Path("/usr/share/kids-os/shell")
CONFIG = pathlib.Path("/etc/kids-os/config.json")
PIN_FILE = pathlib.Path("/etc/kids-os/pin.hash")
RUN = pathlib.Path("/run/kids-os"); UNLOCKED = RUN / "unlocked"
KID_UID, KID_USER = 1001, "kid"
LAUNCHER_PROFILE = "/run/kids-os/launcher"
_fail_lock = threading.Lock(); _failures = 0


def pin_set() -> bool:
    return PIN_FILE.exists()


def check_pin(pin: str) -> bool:
    try:
        salt, digest = PIN_FILE.read_text().strip().split("$", 1)
    except Exception:
        return False
    calc = hashlib.pbkdf2_hmac("sha256", pin.encode(), bytes.fromhex(salt), 100_000).hex()
    return hmac.compare_digest(calc, digest)


def systemctl(*args):
    return subprocess.run(["systemctl", *args], capture_output=True, text=True).returncode == 0


def as_kid(cmd, wait=False):
    env = {"XDG_RUNTIME_DIR": f"/run/user/{KID_UID}", "WAYLAND_DISPLAY": "wayland-0", "HOME": f"/home/{KID_USER}", "PATH": "/usr/bin:/bin"}
    p = subprocess.Popen(["/usr/sbin/runuser", "-u", KID_USER, "--", *cmd], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return p.wait() if wait else 0


class H(BaseHTTPRequestHandler):
    server_version = "kids-sessiond/1"

    def log_message(self, fmt, *a):  # journal gets one line per API call, nothing for statics
        if self.path.startswith("/api/"):
            print(f"{self.command} {self.path} {fmt % a}", flush=True)

    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code); self.send_header("Content-Type", "application/json"); self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body)

    def _body(self):
        n = int(self.headers.get("Content-Length") or 0)
        try:
            return json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            return {}

    def do_GET(self):
        try:
            return self._get()
        except Exception as e:
            traceback.print_exc(); return self._json(500, {"error": str(e)})

    def do_POST(self):
        try:
            return self._post()
        except Exception as e:
            traceback.print_exc(); return self._json(500, {"error": str(e)})

    def _get(self):
        if self.path == "/api/config":
            cfg = json.loads(CONFIG.read_text()) if CONFIG.exists() else {}
            cfg["pin_set"] = pin_set(); cfg["unlocked"] = UNLOCKED.exists()
            return self._json(200, cfg)
        name = self.path.split("?")[0].lstrip("/") or "launcher.html"
        f = (SHELL / name).resolve()
        if not str(f).startswith(str(SHELL)) or not f.is_file():
            return self._json(404, {"error": "not found"})
        ctype = {"html": "text/html; charset=utf-8", "css": "text/css", "js": "text/javascript", "png": "image/png", "svg": "image/svg+xml", "json": "application/json"}.get(f.suffix[1:], "application/octet-stream")
        data = f.read_bytes()
        self.send_response(200); self.send_header("Content-Type", ctype); self.send_header("Content-Length", str(len(data))); self.send_header("Cache-Control", "no-store"); self.end_headers(); self.wfile.write(data)

    def _post(self):
        global _failures
        body = self._body()
        if self.path == "/api/unlock":
            if not pin_set():
                ok = True
            else:
                with _fail_lock:
                    delay = min(_failures, 10)
                time.sleep(delay)
                ok = check_pin(str(body.get("pin", "")))
                with _fail_lock:
                    _failures = 0 if ok else _failures + 1
            if not ok:
                return self._json(403, {"ok": False})
            RUN.mkdir(parents=True, exist_ok=True); UNLOCKED.touch()
            systemctl("start", "--no-block", "kid-session.service")
            return self._json(200, {"ok": True})
        if self.path == "/api/launch":
            url = str(body.get("url", ""))
            if not url.startswith(("https://", "http://")):
                return self._json(400, {"ok": False})
            as_kid(["/usr/lib/kids-os/chrome-kid", "--open", url])
            threading.Timer(1.5, lambda: subprocess.run(["pkill", "-f", f"user-data-dir={LAUNCHER_PROFILE}"])).start()
            return self._json(200, {"ok": True})
        if self.path == "/api/signout":
            try:
                UNLOCKED.unlink()
            except FileNotFoundError:
                pass
            if pin_set():
                systemctl("start", "--no-block", "greeter-session.service")
            else:
                systemctl("restart", "--no-block", "kid-session.service")
            return self._json(200, {"ok": True})
        if self.path == "/api/power":
            action = body.get("action")
            if action in ("poweroff", "reboot"):
                systemctl(action, "--no-block")
                return self._json(200, {"ok": True})
            return self._json(400, {"ok": False})
        return self._json(404, {"error": "not found"})


if __name__ == "__main__":
    RUN.mkdir(parents=True, exist_ok=True)
    ThreadingHTTPServer(("127.0.0.1", 7707), H).serve_forever()
